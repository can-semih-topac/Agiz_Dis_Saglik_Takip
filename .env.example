# Bu dosya bir şablondur, gerçek değerler ".env" dosyasına yazılır (o dosya .gitignore'da,
# repoya girmez). "docker compose up" komutu otomatik olarak ".env" dosyasını okur.

DB_CONNECTION_STRING=Server=db;Database=AgizDisSaglikDb;User Id=ads_app;Password=DEGISTIR;TrustServerCertificate=True;
MSSQL_SA_PASSWORD=DEGISTIR
# Cloudflare Tünelinin kimlik bilgisi dosyası — "cloudflared tunnel create" ile üretilir,
# makinenizdeki gerçek yolu buraya yazın.
CLOUDFLARED_CREDENTIALS_PATH=
JWT_SECRET_KEY=
ENCRYPTION_AES_KEY=
EMAIL_SENDER_PASSWORD=
SENTRY_DSN=
